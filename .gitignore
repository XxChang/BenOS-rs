# =========================
# Bazel outputs (workspace root)
# =========================
# No trailing slash: these are symlinks into the output base, and git treats a
# symlink as a symlink rather than a directory, so `/bazel-*/` would miss them.
/bazel-*

# Bazel lock/state files generated locally
MODULE.bazel.lock

# =========================
# Rust tool artifacts
# =========================
**/*.rs.bk
*.pdb

# =========================
# Editor / OS local files
# =========================
.vscode/
.idea/
.DS_Store
.claude/